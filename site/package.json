{
  "name": "stylo-article",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "gen": "node ../scripts/gen-site-data.mjs",
    "predev": "node ../scripts/gen-site-data.mjs",
    "dev": "vite",
    "prebuild": "node ../scripts/gen-site-data.mjs",
    "build": "npm run check:undef && vite build && npm run test:render",
    "check:undef": "node ./scripts/check-no-undef.mjs",
    "test:render": "node ./scripts/check-render.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dmitrymake/rk-ui": "file:./vendor/rk-ui.tgz",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/parser": "7.29.7",
    "@babel/traverse": "7.29.7",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}

# ───────────────────────── Python ─────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Canonical reproducibility pins are in requirements.lock. uv.lock is a local
# resolver artifact unless deliberately regenerated and reviewed for release.
uv.lock

# ───────────────────── Virtual envs ───────────────────────
.venv/
venv/
env/

# ─────────── Generated artifacts & heavy binaries ─────────
# All model/feature artifacts are regenerable from input/ via the pipeline.
data/
# рабочие черновики: локально, не в git (постоянные эксперименты — в log/experiments/)
tmp/
# измерительный след: эксперименты, прогоны, .log — локально, не в git (gitignore не поддерживает инлайн-комментарии!)
log/
# docs/: heavy artifacts (png/pkl) ignored, но JSON/CSV-метрики РЕЗУЛЬТАТОВ в репо (воспроизводимость:
# генераторы читают эти источники; без них свежий клон не пересоберёт и не проверит числа)
docs/*
!docs/*.json
!docs/*.csv
!docs/cases/
!docs/cases/*.json
!docs/.gitkeep
# Canonical Agentic Engineering workflow paths. Keep every other docs/* path
# closed unless an existing project-specific rule below exposes it.
!docs/agentic/
!docs/agentic/**
!docs/tasks/
!docs/tasks/**
!docs/adr/
!docs/adr/**
!docs/domains/
!docs/domains/**
!docs/runbooks/
!docs/runbooks/**
!docs/handoff/
!docs/handoff/**

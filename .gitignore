!docs/prereg_2026Q3.md
# внутренние рабочие материалы и process-history: НЕ для публичного репо
research/local/
docs/cases/HANDOFF.md
docs/cases/autoscreen/
docs/cases/autoscreen2/
docs/cases/petersburg_hardened/
scripts/build_petersburg_chronicle_manifest.py
scripts/build_petersburg_panel.py
# ranking.json — генерируемый машинный индекс, публичное резюме находится в Taras README
docs/cases/taras_hardened/reports/ranking.json
# результаты LOBO-прогона: per-book отчёт + форматированная таблица (воспроизводимость/инспекция)
!docs/lobo_books.txt
!docs/final_comparison.txt
# CI-sign erratum: corrected .txt/leaderboard derivatives are part of the release inventory
!docs/final_comparison.v2.txt
!docs/ruaa_bench_leaderboard.md
!docs/ruaa_bench_leaderboard_v1.0.1.md

# Belt-and-suspenders: never commit pickled models / numpy dumps anywhere.
*.pkl
*.npy
*.npz
*.joblib

# spaCy DocBin cache (also lives under data/, listed explicitly)
.cache/
*.spacy

# Regenerable cleaned corpus (produced from input/ by the clean step)
input_clean/
# copyright/local raw corpus — НЕ в git (только локально для анализа). git не поддерживает
# inline-комментарии в .gitignore — паттерн обязан быть на отдельной строке.
input/
# прочие raw/приватные корпусы: спорные кейсы, личные тексты (письма/речи Шолохова и др.),
# staging-добор — НЕ в git никогда (копирайт + приватный идиолект живых/недавно умерших авторов)
input_cases/
input_personal/
input_personal_fr/
input_disputed/
_staging_corpora/

